{
  "name": "Artist Promotions Webhook",
  "description": "VAIF-admin seam for the Offers module — create/activate/pause/end an artist's promotion. Auth: shared admin token (VAIF_ADMIN_TOKEN).",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "promotions",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "promo-webhook-0000-0000-0000-000000000001",
      "name": "Promotions Webhook",
      "webhookId": "promo-webhook-0000-0000-0000-000000000001"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body || {};\nconst token = body.admin_token || '';\nconst expected = $env.VAIF_ADMIN_TOKEN || '';\nreturn [{ json: { authorized: token !== '' && token === expected, body: body } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "id": "promo-auth-0000-0000-0000-000000000001",
      "name": "Authorize"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "promo-auth-cond-0000",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "id": "promo-auth-if-0000-0000-0000-000000000001",
      "name": "Authorized?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'unauthorized', message: 'Token de admin inválido.' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        780,
        200
      ],
      "id": "promo-unauth-0000-0000-0000-000000000001",
      "name": "Unauthorized Response"
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 7,
        "output": "={{ $json.body.action === 'list_artists' ? 0 : $json.body.action === 'list_promotions' ? 1 : $json.body.action === 'create' ? 2 : $json.body.action === 'activate' ? 3 : $json.body.action === 'pause' ? 4 : $json.body.action === 'end' ? 5 : 6 }}",
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        780,
        -200
      ],
      "id": "promo-switch-0000-0000-0000-000000000001",
      "name": "Route by Action"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, COALESCE(NULLIF(s.display_name, ''), a.name) AS nome, a.status,\n       (SELECT p.name FROM promotions p WHERE p.artist_id = a.id AND p.status = 'active' LIMIT 1) AS active_promotion\nFROM artists a\nLEFT JOIN artist_settings s ON s.artist_id = a.id\nORDER BY 2;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        -400
      ],
      "id": "promo-list-artists-0000-0000-0000-000000000001",
      "name": "List Artists",
      "credentials": {
        "postgres": {
          "id": "vboyB1OhLNIXIBWt",
          "name": "admin-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nreturn [{ json: { success: true, action: 'list_artists', artists: rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -400
      ],
      "id": "promo-list-artists-resp-0000-0000-0000-000000000001",
      "name": "Build Artists Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id, p.artist_id,\n       COALESCE(NULLIF(s.display_name, ''), a.name) AS artist_name,\n       p.type_key, p.name, p.multiplier, p.audience, p.status,\n       p.activated_at, p.paused_at, p.ended_at, p.quote_valid_days\nFROM promotions p\nJOIN artists a ON a.id = p.artist_id\nLEFT JOIN artist_settings s ON s.artist_id = a.id\nWHERE ($1::uuid IS NULL OR p.artist_id = $1::uuid)\nORDER BY p.created_at DESC\nLIMIT 100;",
        "options": {
          "queryReplacement": "={{ [$json.body.artist_id ? $json.body.artist_id : null] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        -200
      ],
      "id": "promo-list-promos-0000-0000-0000-000000000001",
      "name": "List Promotions",
      "credentials": {
        "postgres": {
          "id": "vboyB1OhLNIXIBWt",
          "name": "admin-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nreturn [{ json: { success: true, action: 'list_promotions', promotions: rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -200
      ],
      "id": "promo-list-promos-resp-0000-0000-0000-000000000001",
      "name": "Build Promotions Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO promotions (artist_id, type_key, name, multiplier, audience)\nVALUES ($1::uuid, COALESCE(NULLIF($2::text, ''), 'bogo_same_value'),\n        COALESCE(NULLIF($3::text, ''), 'Promoção'),\n        COALESCE(NULLIF($4::numeric, NULL), 2.0),\n        COALESCE(NULLIF($5::text, ''), 'all'))\nRETURNING id, artist_id, type_key, name, multiplier, audience, status;",
        "options": {
          "queryReplacement": "={{ [$json.body.artist_id, $json.body.type_key, $json.body.name, $json.body.multiplier, $json.body.audience] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        0
      ],
      "id": "promo-create-0000-0000-0000-000000000001",
      "name": "Create Promotion",
      "credentials": {
        "postgres": {
          "id": "vboyB1OhLNIXIBWt",
          "name": "admin-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { success: true, action: 'create', promotion: r } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "id": "promo-create-resp-0000-0000-0000-000000000001",
      "name": "Build Create Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT id, artist_id FROM promotions WHERE id = $1::uuid)\nSELECT id, artist_id, name, multiplier, status\nFROM activate_promotion((SELECT artist_id FROM p), (SELECT id FROM p))\nUNION ALL\nSELECT NULL::uuid, NULL::uuid, NULL::text, NULL::numeric, NULL::text\nWHERE NOT EXISTS (SELECT 1 FROM p);",
        "options": {
          "queryReplacement": "={{ [$json.body.promotion_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        200
      ],
      "id": "promo-activate-0000-0000-0000-000000000001",
      "name": "Activate Promotion",
      "credentials": {
        "postgres": {
          "id": "vboyB1OhLNIXIBWt",
          "name": "admin-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (!r.id) {\n  return [{ json: { success: false, action: $json.body.action, error: 'transition_not_allowed', message: 'Transição não permitida.' } }];\n}\nreturn [{ json: { success: true, action: $json.body.action, promotion: r } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ],
      "id": "promo-activate-resp-0000-0000-0000-000000000001",
