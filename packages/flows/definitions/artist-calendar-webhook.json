{
  "name": "Artist Calendar Webhook",
  "description": "Agenda admin webhook (#29) — list scheduled tattoos + availability (derived 60-min slots + blocks), block/unblock time ranges, and suspend/resume the SDR for an artist, backed by Postgres. Auth: per-artist onboarding token; unknown/invalid tokens are rejected.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calendar",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "cal-webhook-0000-0000-0000-000000000001",
      "name": "Calendar Webhook",
      "webhookId": "cal-webhook-0000-0000-0000-000000000001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  a.id, a.nome, a.timezone, a.status,\n  $1::text     AS token,\n  $2::text     AS action,\n  $3::text     AS start_at,\n  $4::text     AS end_at,\n  $5::text     AS block_id,\n  $6::integer  AS duration_min,\n  (a.id IS NOT NULL) AS found\nFROM artists a\nWHERE a.onboarding_token = $1\nUNION ALL\nSELECT\n  NULL::uuid, NULL::text, NULL::text, NULL::text,\n  $1::text, $2::text, $3::text, $4::text, $5::text, $6::integer,\n  false AS found\nWHERE NOT EXISTS (SELECT 1 FROM artists a WHERE a.onboarding_token = $1)\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.body.token, $json.body.action, $json.body.start_at, $json.body.end_at, $json.body.block_id, $json.body.duration_min] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        0
      ],
      "id": "cal-resolve-0000-0000-0000-000000000001",
      "name": "Resolve Artist by Token",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cal-if-token-cond-0000",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "id": "cal-if-token-0000-0000-0000-000000000001",
      "name": "Token Valid?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'invalid_token', message: 'Token de artista inválido ou desconhecido.' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        780,
        200
      ],
      "id": "cal-resp-bad-token-0000-0000-0000-000000000001",
      "name": "Invalid Token Response"
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 6,
        "output": "={{ $json.action === 'list' ? 0 : $json.action === 'block' ? 1 : $json.action === 'unblock' ? 2 : $json.action === 'suspend' ? 3 : $json.action === 'resume' ? 4 : 5 }}",
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        780,
        -200
      ],
      "id": "cal-switch-0000-0000-0000-000000000001",
      "name": "Route by Action"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "(\n  SELECT id, start_at, end_at, type, lead_nome, placement, telefone\n  FROM (\n    SELECT id, start_at, end_at, 'available'::text AS type,\n           NULL::text AS lead_nome, NULL::text AS placement, NULL::text AS telefone\n    FROM check_availability(\n      $1::uuid,\n      COALESCE($2::timestamptz, date_trunc('day', now())::timestamptz),\n      COALESCE($3::timestamptz, now() + interval '60 days'),\n      COALESCE($4::integer, 60)\n    )\n    UNION ALL\n    SELECT c.id, c.start_at, c.end_at, c.type,\n           NULL::text, NULL::text, NULL::text\n    FROM calendar c\n    WHERE c.artist_id = $1::uuid\n      AND c.type = 'blocked'\n      AND c.end_at > now()\n    UNION ALL\n    SELECT c.id, c.start_at, c.end_at, 'booked'::text AS type,\n           l.nome, l.placement, l.telefone\n    FROM calendar c\n    LEFT JOIN leads l ON l.id = c.lead_id\n    WHERE c.artist_id = $1::uuid\n      AND c.type = 'booked'\n      AND c.end_at > now()\n  ) s\n  ORDER BY start_at\n)\nUNION ALL\nSELECT NULL::uuid, NULL::timestamptz, NULL::timestamptz, NULL::text,\n       NULL::text, NULL::text, NULL::text;",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.start_at, $json.end_at, $json.duration_min] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        -400
      ],
      "id": "cal-list-0000-0000-0000-000000000001",
      "name": "List Availability",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst artist = $('Resolve Artist by Token').first().json;\n\nconst available = [];\nconst blocks = [];\nconst booked = [];\n\nfor (const item of items) {\n  const row = item.json;\n  if (!row.id) continue; // sentinel row\n  if (row.type === 'booked') {\n    booked.push({\n      id: row.id,\n      start_at: row.start_at,\n      end_at: row.end_at,\n      client_name: row.lead_nome || null,\n      placement: row.placement || null,\n      telefone: row.telefone || null,\n    });\n  } else if (row.type === 'blocked') {\n    blocks.push({ id: row.id, start_at: row.start_at, end_at: row.end_at });\n  } else {\n    available.push({ id: row.id, start_at: row.start_at, end_at: row.end_at });\n  }\n}\n\nreturn [{\n  json: {\n    success: true,\n    action: 'list',\n    artist_id: artist.id,\n    artist_name: artist.nome,\n    duration_min: artist.duration_min || 60,\n    timezone: artist.timezone,\n    status: artist.status,\n    available,\n    blocks,\n    booked,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -400
      ],
      "id": "cal-list-resp-0000-0000-0000-000000000001",
      "name": "Build List Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, artist_id, start_at, end_at, type\nFROM block_slot($1::uuid, $2::timestamptz, $3::timestamptz);",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.start_at, $json.end_at] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        -200
      ],
      "id": "cal-block-0000-0000-0000-000000000001",
      "name": "Block Slot",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    action: 'block',\n    block: { id: row.id, start_at: row.start_at, end_at: row.end_at },\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -200
      ],
      "id": "cal-block-resp-0000-0000-0000-000000000001",
      "name": "Build Block Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH removed AS (\n  SELECT * FROM unblock_slot($1::uuid)\n)\nSELECT id, artist_id, start_at, end_at, type\nFROM removed\nUNION ALL\nSELECT NULL::uuid, NULL::uuid, NULL::timestamptz, NULL::timestamptz, NULL::text\nWHERE NOT EXISTS (SELECT 1 FROM removed);",
        "options": {
          "queryReplacement": "={{ [$json.block_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        0
      ],
      "id": "cal-unblock-0000-0000-0000-000000000001",
      "name": "Unblock Slot",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nif (!row.id) {\n  return [{\n    json: {\n      success: false,\n      action: 'unblock',\n      error: 'block_not_found',\n      message: 'Bloqueio não encontrado.',\n    }\n  }];\n}\nreturn [{\n  json: {\n    success: true,\n    action: 'unblock',\n    block: { id: row.id, start_at: row.start_at, end_at: row.end_at },\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "id": "cal-unblock-resp-0000-0000-0000-000000000001",
      "name": "Build Unblock Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, status FROM suspend_artist($1::uuid);",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        200
      ],
      "id": "cal-suspend-0000-0000-0000-000000000001",
      "name": "Suspend Artist",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nif (!row.id) {\n  return [{\n    json: {\n      success: false,\n      action: $json.action,\n      error: 'status_transition_not_allowed',\n      message: 'Transição de status não permitida.',\n    }\n  }];\n}\nreturn [{\n  json: {\n    success: true,\n    action: $json.action,\n    status: row.status,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ],
      "id": "cal-suspend-resp-0000-0000-0000-000000000001",
      "name": "Build Suspend Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, status FROM resume_artist($1::uuid);",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        400
      ],
      "id": "cal-resume-0000-0000-0000-000000000001",
      "name": "Resume Artist",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nif (!row.id) {\n  return [{\n    json: {\n      success: false,\n      action: $json.action,\n      error: 'status_transition_not_allowed',\n      message: 'Transição de status não permitida.',\n    }\n  }];\n}\nreturn [{\n  json: {\n    success: true,\n    action: $json.action,\n    status: row.status,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        400
      ],
      "id": "cal-resume-resp-0000-0000-0000-000000000001",
      "name": "Build Resume Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1560,
        -200
      ],
      "id": "cal-resp-ok-0000-0000-0000-000000000001",
      "name": "Calendar Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'invalid_action', message: 'Ação desconhecida. Use list, block, unblock, suspend ou resume.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1040,
        -500
      ],
      "id": "cal-resp-bad-action-0000-0000-0000-000000000001",
      "name": "Invalid Action Response"
    }
  ],
