      "id": "cal-resp-ok-0000-0000-0000-000000000001",
      "name": "Calendar Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'invalid_action', message: 'Ação desconhecida. Use list, block, unblock, suspend, resume, customers, import_customer ou return_chat.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1040,
        -500
      ],
      "id": "cal-resp-bad-action-0000-0000-0000-000000000001",
      "name": "Invalid Action Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  l.phone_e164 AS telefone,\n  l.name AS nome,\n  p.stage_key AS pipeline_status,\n  is_returning_customer($1::uuid, l.phone_e164) AS is_returning,\n  chat_owner($1::uuid, $2::text || ':' || l.phone_e164) AS owner,\n  $2::text || ':' || l.phone_e164 AS chat_id\nFROM leads l\nLEFT JOIN LATERAL (\n  SELECT stage_key FROM projects\n   WHERE projects.lead_id = l.id AND projects.artist_id = l.artist_id\n   ORDER BY updated_at DESC LIMIT 1\n) p ON true\nWHERE l.artist_id = $1::uuid\n  AND l.phone_e164 IS NOT NULL\nORDER BY COALESCE(l.last_message_at, l.created_at) DESC\nLIMIT 200\nUNION ALL\nSELECT NULL::text, NULL::text, NULL::text, false, 'agent'::text, NULL::text\nWHERE NOT EXISTS (SELECT 1 FROM leads WHERE artist_id = $1::uuid);",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.slug] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        600
      ],
      "id": "cal-customers-0000-0000-0000-000000000001",
      "name": "List Customers",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst artist = $('Resolve Artist by Token').first().json;\nconst customers = [];\nfor (const item of items) {\n  const r = item.json;\n  if (!r.telefone) continue; // sentinel row\n  customers.push({\n    telefone: r.telefone,\n    nome: r.nome || null,\n    pipeline_status: r.pipeline_status,\n    is_returning: r.is_returning === true,\n    owner: r.owner,\n    chat_id: r.chat_id,\n  });\n}\nreturn [{\n  json: { success: true, action: 'customers', artist_name: artist.nome, customers }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        600
      ],
      "id": "cal-customers-resp-0000-0000-0000-000000000001",
      "name": "Build Customers Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT phone_e164 AS telefone, name AS nome, source\nFROM import_returning_customer($1::uuid, $2::text, NULLIF($3::text, ''), NULL);",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.telefone, $json.nome_param] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        800
      ],
      "id": "cal-import-0000-0000-0000-000000000001",
      "name": "Import Customer",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    action: 'import_customer',\n    customer: { telefone: r.telefone, nome: r.nome, source: r.source },\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        800
      ],
      "id": "cal-import-resp-0000-0000-0000-000000000001",
      "name": "Build Import Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (SELECT * FROM return_chat_control($1::uuid, $2::text))\nSELECT chat_id, owner FROM r\nUNION ALL\nSELECT NULL::text, NULL::text WHERE NOT EXISTS (SELECT 1 FROM r);",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.chat_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1040,
        1000
      ],
      "id": "cal-returnchat-0000-0000-0000-000000000001",
      "name": "Return Chat",
      "credentials": {
        "postgres": {
          "id": "nngaQDfXHYQ1Q43P",
          "name": "main-db"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    action: 'return_chat',\n    chat: { chat_id: r.chat_id || $json.chat_id, owner: r.owner || 'agent' },\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        1000
      ],
      "id": "cal-returnchat-resp-0000-0000-0000-000000000001",
      "name": "Build Return Chat Response"
    }
  ],
