          }
        ],
        [
          {
            "node": "Invalid Action Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Availability": {
      "main": [
        [
          {
            "node": "Build List Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build List Response": {
      "main": [
        [
          {
            "node": "Calendar Response",
            "type": "main",
