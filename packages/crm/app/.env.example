APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

WAHA_API_URL=https://waha.vaif.com.br
WAHA_API_KEY=
WAHA_WEBHOOK_URL=https://crm.vaif.com.br/api/webhooks/waha
# Shared header required by the CRM webhook (falls back to CRM_INTERNAL_TOKEN).
WAHA_WEBHOOK_TOKEN=
N8N_WAHA_WEBHOOK_URL=https://n8n.vaif.com.br/webhook/waha-webhook
N8N_WAHA_WEBHOOK_TOKEN=
ONBOARD_WEBHOOK_TOKEN=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Calendar (service account). Raw JSON, base64 JSON or a file path.
# See docs/google-calendar.md for the Google Cloud setup.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- WhatsApp agent (Beatriz) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=anthropic/claude-haiku-5.5
AGENT_PREFLIGHT_MODEL=
AGENT_CLAIMS_MODEL=
AGENT_REPAIR_MODEL=
AGENT_AUDIO_MODEL=google/gemini-2.5-flash
AGENT_VISION_MODEL=google/gemini-2.5-flash
AGENT_JUDGE_MODEL=
AGENT_HUMANIZE=true
AGENT_AI_TIMEOUT=30
AGENT_AI_RETRIES=2
AGENT_QUEUE=agent
AGENT_QUIET_MS=6000
AGENT_MAX_WAIT_MS=20000
AGENT_TYPING_GRACE_MS=30000
AGENT_EVAL_ENABLED=false
AGENT_EVAL_MODEL=
AGENT_CALIBRATION_MIN_COMPARED=40
AGENT_CALIBRATION_MIN_ACCEPTABLE=0.9
AGENT_CALIBRATION_MIN_RESPONSE=0.9
AGENT_CALIBRATION_MIN_PER_INTENT=5

# --- Staff Copilot (ops + calibration reports) ---
COPILOT_ENABLED=true
COPILOT_MODEL=
COPILOT_TIMEZONE=America/Sao_Paulo
COPILOT_DAILY_TIME=08:00
COPILOT_WEEKLY_DAY=1
COPILOT_WEEKLY_TIME=08:10
COPILOT_MAIL=true
COPILOT_RECIPIENTS=
